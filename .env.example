# Configure secrets locally. Never commit .env.
OPENAI_API_KEY=
ASSISTANT_API_TOKEN=
QDRANT_API_KEY=
OPENAI_MODEL=gpt-6-astra
REASONING_EFFORT=high
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
QDRANT_URL=http://127.0.0.1:6333
DATA_DIR=output
STATE_DIR=state
# macOS Colima profile from scripts/setup_macos.sh. Omit on Linux/default Docker.
DOCKER_CONTEXT=colima-analytics
SANDBOX_IMAGE=retail-agent-sandbox:local
MAX_CONCURRENT_JOBS=1
MAX_PENDING_JOBS=8
